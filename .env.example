# Swiggy MCP
SWIGGY_BASE_URL=https://mcp.swiggy.com
# Local OAuth callback for the Day-1 probe (http://localhost is allowed for dev)
SWIGGY_REDIRECT_URI=http://localhost:8765/callback

# Safety: 1 = never call checkout (default outside filming)
DRY_RUN=1

# Mom's delivery address id from `probe.py call get_addresses`
MOM_ADDRESS_ID=

# Agent LLM (Google Gemini). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Child channel: token from @BotFather (bot uses long polling, no public URL needed)
TELEGRAM_BOT_TOKEN=

# Public HTTPS base URL for the WhatsApp webhook (ngrok free static dev domain)
PUBLIC_BASE_URL=https://your-name.ngrok-free.dev

# Path to ngrok.exe (v3.39+)
NGROK_BIN=

# Speech-to-text (Saaras) + text-to-speech (Bulbul). Key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# WhatsApp Cloud API (Meta). Verify token: any random string, same value in Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (used to check X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# System-user permanent token (whatsapp_business_messaging, whatsapp_business_management)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Mom's WhatsApp number, digits only with country code, e.g. 919812345678
MOM_WHATSAPP_NUMBER=
STATE_DB=state.db
