# Swiggy MCP
SWIGGY_BASE_URL=https://mcp.swiggy.com
# Local OAuth callback for the probe login (http://localhost is allowed for dev)
SWIGGY_REDIRECT_URI=http://localhost:8765/callback

# Safety: 1 = never book tables or place orders
DRY_RUN=1

# Planner LLM (Google Gemini). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Plan Bana group bot: token from @BotFather (long polling, no public URL needed).
# Privacy mode must be off (/setprivacy -> Disable), then remove + re-add the bot to the group.
PLAN_TELEGRAM_BOT_TOKEN=
# Your own Telegram user id (only this user can run /debug)
PLAN_OWNER_TELEGRAM_ID=
PLAN_DB_PATH=plan_bana.db

# Default group location for scripts/try_plan.py (lat, lng, label)
PLAN_LAT=
PLAN_LNG=
PLAN_AREA=
